{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false
  },
  "include": ["*.js", "*.d.ts"],
  "//exclude": "qrcode.js 是内嵌的第三方库（qrcode-generator v1.4.4, MIT，见 LICENSE-THIRD-PARTY.txt），上游是老式写法、过不了 checkJs；我们不改它，类型在 globals.d.ts 里手写。",
  "exclude": ["qrcode.js"]
}
